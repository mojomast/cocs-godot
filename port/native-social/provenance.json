    "chat_reply": "{\"type\":\"chat\",\"peerId\":1,\"name\":\"...\",\"text\":\"...\",\"time\":0}",
    "chat_bounds": "sanitizeText(text, 200); per-peer 300 ms floor; room-scoped broadcast",
    "out_of_room_error": "{\"type\":\"error\",\"message\":\"not in a room\"}"
  },

  "scope": "native multiplayer room browser + room-scoped text chat",
  "authority_contract": {
    "list": "{\"type\":\"list\"}",
    "rooms_reply": "{\"type\":\"rooms\",\"rooms\":[summary,...]}",
    "summary_fields": ["roomId", "name", "players", "started", "mapId", "config"],
